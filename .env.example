# Ayetis Portal — local development
# Uses your Docker MongoDB container (`mongodb` / mongo:7)
#
# If `docker ps` shows empty PORTS, publish Mongo before connecting:
#   sudo docker start mongodb
#   # or recreate with: -p 27017:27017

PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/ayetis-portal
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
SEED_ADMIN_EMAIL=admin@ayetis.com
SEED_ADMIN_PASSWORD=Admin@12345

# Resend transactional email (https://resend.com)
# Leave RESEND_API_KEY empty in local dev to log emails to the console.
RESEND_API_KEY=
EMAIL_FROM=Ayetis Portal <onboarding@resend.dev>

# File storage: local disk (default) or S3-compatible Railway buckets
# STORAGE_PROVIDER=local|s3
STORAGE_PROVIDER=local
UPLOADS_DIR=
# Max upload size in bytes (default 500MB)
MAX_UPLOAD_BYTES=524288000

# Password policy
# Days after last password change before a forced reset (0 = never expire)
PASSWORD_EXPIRY_DAYS=90
# Idle minutes before the client logs the user out (0 = disable). Also editable in Settings.
SESSION_IDLE_TIMEOUT_MINUTES=30
# Failed password attempts before temporary lockout
LOGIN_MAX_FAILED_ATTEMPTS=5
# Minutes an account stays locked after max failed attempts
LOGIN_LOCKOUT_MINUTES=15
# Seconds a signed file download URL remains valid
SIGNED_URL_TTL_SECONDS=300
# Optional absolute API base for signed local-file URLs in production
API_PUBLIC_URL=

# Railway / S3-compatible bucket (required when STORAGE_PROVIDER=s3)
# Objects are private; downloads go through authenticated API streams.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Cold storage (cost-minimal): unused files go to Glacier Flexible Retrieval after FILE_HOT_DAYS.
# Access uses temporary RestoreObject only — objects are NOT promoted back to Standard (no rewrite fee).
# Local provider uses free renames under uploads/hot ↔ uploads/cold.
# FILE_RESTORE_TIER=Bulk is the cheapest restore option (slower than Standard/Expedited).
FILE_HOT_DAYS=30
FILE_COLD_STORAGE_ENABLED=true
FILE_COLD_STORAGE_CLASS=GLACIER
FILE_RESTORE_TIER=Bulk
FILE_RESTORE_DAYS=30
FILE_COLD_DELETE_AFTER_DAYS=365
FILE_COLD_STORAGE_CRON=0 * * * *
