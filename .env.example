# Ayetis Portal — local development
# Uses your Docker MongoDB container (`mongodb` / mongo:7)
#
# If `docker ps` shows empty PORTS, publish Mongo before connecting:
#   sudo docker start mongodb
#   # or recreate with: -p 27017:27017

PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/ayetis-portal
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
SEED_ADMIN_EMAIL=admin@ayetis.com
SEED_ADMIN_PASSWORD=Admin@12345
