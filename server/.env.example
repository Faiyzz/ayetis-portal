PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/ayetis-portal
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
SEED_ADMIN_EMAIL=admin@ayetis.com
SEED_ADMIN_PASSWORD=Admin@12345

RESEND_API_KEY=
EMAIL_FROM=Ayetis Portal <onboarding@resend.dev>

# local (default) or s3 for Railway / S3-compatible private buckets
STORAGE_PROVIDER=local
UPLOADS_DIR=
MAX_UPLOAD_BYTES=524288000
PASSWORD_EXPIRY_DAYS=90
SIGNED_URL_TTL_SECONDS=300
API_PUBLIC_URL=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
